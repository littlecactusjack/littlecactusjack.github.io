# Copy to bot/.env on the droplet and fill in. Never commit bot/.env.
DISCORD_TOKEN=paste-the-bot-token-here
DISCORD_CHANNEL_ID=123456789012345678
# optional: only accept commands from this Discord user id
DISCORD_USER_ID=
# optional: where state.json and demo_log.csv live (default: the bot folder)
BOT_DATA_DIR=
