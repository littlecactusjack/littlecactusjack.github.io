// A121-A137 (decisions.md 1092-1111): Bulenox Fast Track — one bracket a day, with the Fast Track account rules simulated on top.
// Use on MNQ1! (MGC1! for the MGC plans), 1-minute chart, extended hours ON. Commission $0.61/side is MNQ; set $0.76 in Properties for MGC.
// Green label = payout (amount before split), red label = account blown (a new one is bought next day).
//@version=5
strategy("Fast Track bracket (Bulenox)", overlay=true, pyramiding=0, process_orders_on_close=true,
     default_qty_type=strategy.fixed, default_qty_value=3, commission_type=strategy.commission.cash_per_contract,
     commission_value=0.61, initial_capital=50000, max_labels_count=500)

grpP = "Plan"
plan = input.string("100K · MNQ day session", "Plan preset (sets everything below unless Custom)", options=["50K · MNQ day session", "100K · MNQ day session", "100K · MNQ full session", "100K · MGC full session", "100K · MGC London", "Custom"], group=grpP)

grpT = "Trade (used when the plan is Custom)"
cSide   = input.string("Long", "Side (same on every account)", options=["Long", "Short"], group=grpT)
cQty    = input.int(3, "Contracts (micros)", minval=1, group=grpT)
cTp     = input.float(108.25, "Take profit (points)", group=grpT)
cSl     = input.float(333.25, "Stop (points)", group=grpT)
cEntry  = input.int(930, "Entry (HHMM, bar closing at this time)", group=grpT)
cFlat   = input.int(1600, "Flatten (HHMM)", group=grpT)
tz      = input.string("America/New_York", "Time zone for the times", group=grpT)

grpA = "Fast Track account (used when the plan is Custom)"
cSize   = input.string("50K", "Account size", options=["25K", "50K", "100K", "150K"], group=grpA)
disc    = input.float(0.55, "Price paid as a share of list (0.55 = 45% off)", group=grpA)
pmin    = input.float(1000, "Minimum payout", group=grpA)
split   = input.float(0.90, "Your split", group=grpA)
monthly = input.float(0, "Bot fee per month (0 if manual)", group=grpA)

// presets: decisions.md §1098-§1099 (terms from Bulenox's help center, 2026-10-29)
acct = plan == "Custom" ? cSize : plan == "50K · MNQ day session" ? "50K" : "100K"
fee   = disc * (acct == "25K" ? 338 : acct == "50K" ? 488 : acct == "100K" ? 648 : 788)
dd    = acct == "25K" ? 1000 : acct == "50K" ? 2000 : acct == "100K" ? 4000 : 5500
lockAt = 100.0
goal1 = acct == "25K" ? 1500 : acct == "50K" ? 3000 : acct == "100K" ? 6000 : 9000
goalN = acct == "25K" ? 1000 : acct == "50K" ? 2000 : acct == "100K" ? 3000 : 4500
cap13 = acct == "25K" ? 1000 : acct == "50K" ? 2000 : acct == "100K" ? 2500 : 3000
cap4  = acct == "25K" ? 1250 : acct == "50K" ? 2500 : acct == "100K" ? 3000 : 3500
side   = plan == "Custom" ? cSide : "Long"
qty    = plan == "Custom" ? cQty : plan == "50K · MNQ day session" ? 3 : 7
tpPts  = plan == "Custom" ? cTp : plan == "50K · MNQ day session" ? 108.25 : (plan == "100K · MGC London" or plan == "100K · MGC full session") ? 11.4 : 57.25
slPts  = plan == "Custom" ? cSl : plan == "50K · MNQ day session" ? 333.25 : (plan == "100K · MGC London" or plan == "100K · MGC full session") ? 57.1 : 285.75
entryHM = plan == "Custom" ? cEntry : (plan == "100K · MNQ full session" or plan == "100K · MGC full session") ? 1801 : plan == "100K · MGC London" ? 300 : 930
flatHM  = plan == "Custom" ? cFlat : (plan == "100K · MNQ full session" or plan == "100K · MGC full session") ? 1655 : plan == "100K · MGC London" ? 1130 : 1600

// ---- the trade
hm(t) => hour(t, tz) * 100 + minute(t, tz)
dir = side == "Long" ? 1 : -1
dow = dayofweek(time_close, tz)
// an evening entry (18:01, the first bar after the 18:00 reopen) trades Sunday-Thursday evenings for the next day's session; day entries Monday-Friday
wkday = entryHM > flatHM ? (dow != dayofweek.friday and dow != dayofweek.saturday) : (dow != dayofweek.saturday and dow != dayofweek.sunday)
var int entryDay = na

if hm(time_close) == entryHM and wkday and strategy.position_size == 0
    strategy.entry("FT", dir == 1 ? strategy.long : strategy.short, qty)
    entryDay := dayofmonth(time_close, tz)
strategy.exit("FT x", "FT", profit=tpPts / syminfo.mintick, loss=slPts / syminfo.mintick)
// flatten at the set time, or on the next day if a short session never reached it
overnight = entryHM > flatHM
if strategy.position_size != 0 and (hm(time_close) == flatHM or (not overnight and dayofmonth(time_close, tz) != entryDay))
    strategy.close_all("Flatten")

// ---- the account (P&L relative to the $50,000 start)
var float bal = 0.0
var float pk = 0.0
var int   npay = 0
var float cyc = 0.0          // profit since the last payout
var float cbest = 0.0        // best day since the last payout
var bool  dead = false       // blown during the open trade; the rest of that trade is ignored
var int   bought = 1
var int   payouts = 0
var float paid = 0.0
var int   lastClosed = 0
var int   t0 = na
t0 := na(t0) ? time : t0

resetAccount() =>
    label.new(bar_index, high, "blown", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.tiny)

flr = math.min(pk - dd, lockAt)
pos = strategy.position_size
if pos != 0 and not dead
    q = math.abs(pos)
    avg = strategy.position_avg_price
    fav = math.min(dir == 1 ? high - avg : avg - low, tpPts)
    adv = math.max(dir == 1 ? low - avg : avg - high, -slPts)
    pk := math.max(pk, bal + fav * q * syminfo.pointvalue)            // intraday trailing: the open profit lifts the peak
    flr := math.min(pk - dd, lockAt)
    if bal + adv * q * syminfo.pointvalue <= flr
        dead := true
        resetAccount()
        bought += 1
        bal := 0.0
        pk := 0.0
        npay := 0
        cyc := 0.0
        cbest := 0.0

if strategy.closedtrades > lastClosed
    pnl = strategy.closedtrades.profit(strategy.closedtrades - 1)
    lastClosed := strategy.closedtrades
    if dead
        dead := false
    else
        bal += pnl
        pk := math.max(pk, bal)
        flr := math.min(pk - dd, lockAt)
        if bal <= flr
            resetAccount()
            bought += 1
            bal := 0.0
            pk := 0.0
            npay := 0
            cyc := 0.0
            cbest := 0.0
        else
            cyc += pnl
            cbest := math.max(cbest, pnl)
            goal = npay == 0 ? goal1 : goalN
            cons = npay == 0 ? 0.20 : npay == 1 ? 0.25 : 0.30
            amt = math.min(bal - lockAt, npay < 3 ? cap13 : cap4)
            if cyc >= goal and cyc > 0 and cbest <= cons * cyc and amt >= pmin
                bal -= amt
                npay += 1
                payouts += 1
                paid += amt * split
                cyc := 0.0
                cbest := 0.0
                label.new(bar_index, low, "$" + str.tostring(amt, "#,###"), color=color.green, textcolor=color.white,
                     style=label.style_label_up, size=size.tiny)

// ---- summary
months = (time - t0) / (1000.0 * 60 * 60 * 24 * 30.44)
fees = bought * fee + monthly * months
var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    rows = array.from("Months tested", "Accounts bought", "Payouts", "Accounts per payout", "Paid to you (after split)",
         "Fees (accounts + bot)", "Net", "Net per month (1 slot)")
    vals = array.from(str.tostring(months, "#.0"), str.tostring(bought), str.tostring(payouts),
         payouts > 0 ? str.tostring(bought / payouts, "#.00") : "-", "$" + str.tostring(paid, "#,###"),
         "$" + str.tostring(fees, "#,###"), "$" + str.tostring(paid - fees, "#,###"),
         "$" + str.tostring(months > 0 ? (paid - fees) / months : 0, "#,###"))
    for i = 0 to 7
        table.cell(tb, 0, i, array.get(rows, i), text_color=color.white, text_halign=text.align_left, text_size=size.small)
        table.cell(tb, 1, i, array.get(vals, i), text_color=color.white, text_halign=text.align_right, text_size=size.small)
